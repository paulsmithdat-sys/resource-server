{
  "name": "resource-server",
  "version": "0.0.1",
  "description": "JSON Schema in, JSON:API server out (Bun, Hono, Turso/SQLite)",
  "type": "module",
  "bin": {
    "resource-server": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./build-schema": "./src/db/build-schema.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/seed",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "db:migrate": "bunx drizzle-kit migrate --config drizzle.config.ts",
    "db:generate": "bun src/db/generate-migration.ts",
    "db:reset": "bun src/db/reset.ts",
    "dev": "bun --watch src/server/index.ts",
    "start": "bun src/server/index.ts",
    "test": "bun test",
    "cli": "bun src/cli.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@serenity-kit/opaque": "^1.1.0",
    "@tursodatabase/database": "^0.8.3",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^1.0.0-rc.5",
    "drizzle-orm": "^1.0.0-rc.5",
    "hono": "^4.13.17",
    "json-schema-to-ts": "^3.1.1",
    "ts-japi": "^1.12.6",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7"
  }
}
