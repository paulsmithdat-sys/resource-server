{
  "style": "biome",
  "indent": 2,
  "lineWidth": 80,
  "semicolons": true,
  "quoteStyle": "double",
  "trailingComma": "all",
  "toArrow": false,
  "biome": true,
  "functional": {
    "commaStyle": "leading",
    "objectValueIndent": 1,
    "arrayValueIndent": 2,
    "forceBlankLines": true,
    "semicolons": true,
    "maxInlineArrayItems": 3
  },
  "metrics": {
    "excludeUnder": 0,
    "testCommand": "bun run test",
    "thresholds": {
      "maxCyclomatic": 20,
      "minFtaScore": 50
    }
  },
  "mcp": {
    "codegraph": true,
    "metrics": true
  },
  "insights": {
    "benchmark": {
      "baseline": "previous",
      "targets": {
        "minTestPassRate": 1,
        "maxCyclomaticDelta": 0,
        "minAvgFtaScoreDelta": 0,
        "maxHalsteadBugsDelta": 0,
        "maxTotalLinesDelta": null
      },
      "tolerance": {
        "testsPassRate": 0,
        "avgFtaScore": 0.1,
        "avgCyclomatic": 0.1,
        "halsteadBugs": 0.01,
        "totalLines": 0
      }
    },
    "score": {
      "weights": {
        "gate": 25,
        "fta": 20,
        "complexity": 15,
        "tests": 25,
        "trend": 10,
        "dependencies": 5
      },
      "grades": {
        "A": 90,
        "B": 80,
        "C": 70,
        "D": 60
      },
      "missingDataCredit": 0.5
    },
    "dependencies": {
      "manifests": [
        "package.json"
      ],
      "penalties": {
        "runtime": 5,
        "dev": 2,
        "optional": 1,
        "peer": 1
      },
      "removalBonuses": {
        "runtime": 3,
        "dev": 1,
        "optional": 0.5,
        "peer": 0.5
      },
      "offset": {
        "minLinesReduced": 20,
        "minCyclomaticReduced": 1,
        "bonusPerDependency": 2
      },
      "allow": [],
      "deny": []
    },
    "commit": {
      "requirePendingSnapshot": true,
      "requireTestsPassing": true,
      "requireGatePassing": true,
      "maxChangedFiles": 10,
      "maxChangedLines": 300,
      "suggestSplit": true,
      "dependencyChangesSeparate": true
    }
  }
}
